<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yutong</groupId>
        <artifactId>yutong-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>yutong-boot</artifactId>
    <name>YuTong Boot</name>
    <description>单体启动器: 聚合所有模块，boot 模式默认入口</description>

    <dependencies>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-auth-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-system-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-sample-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-lowcode-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-ai-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yutong</groupId>
            <artifactId>yutong-workflow-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- GA2-03-6: @RequiresPermission AOP 切面支持 (TC-SEC-AUTH-001)。spring-aop 已随 web 引入，此处补充 aspectjweaver -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Micrometer Prometheus registry for P5-04 monitoring -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- GA2-L180: 契约测试基础设施依赖 (test scope) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 模块化: @AutoConfigureMockMvc 已移至 spring-boot-starter-webmvc-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
