{
  "title": "YuTong Lowcode Overview",
  "tags": ["yutong", "lowcode"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Generate Task Rate (task/s)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(lowcode_generate_task_total[1m]))", "legendFormat": "task/s" }
      ]
    },
    {
      "id": 2,
      "title": "Generate Task Success Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        { "expr": "sum(rate(lowcode_generate_task_total{status=\"SUCCESS\"}[5m])) / sum(rate(lowcode_generate_task_total[5m]))", "legendFormat": "success %" }
      ]
    },
    {
      "id": 3,
      "title": "Generate Task Conflict Count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(lowcode_generate_task_total{status=\"CONFLICT\"})", "legendFormat": "conflicts" }
      ]
    },
    {
      "id": 4,
      "title": "Generate Duration (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(lowcode_generate_duration_seconds_bucket[5m])) by (le, scope))", "legendFormat": "P95 {{scope}}" }
      ]
    },
    {
      "id": 5,
      "title": "Tasks by Scope",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "sum(rate(lowcode_generate_task_total[5m])) by (scope)", "legendFormat": "{{scope}}" }
      ]
    },
    {
      "id": 6,
      "title": "Tasks by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "sum(rate(lowcode_generate_task_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
