# YuTong 微服务网关模式本地部署环境变量 [T]
# 镜像/容器统一前缀: yutong-*
# 端口规划: (20000-20099 段)

# 应用配置
SPRING_PROFILES_ACTIVE=local
YUTONG_AUTH_MODE=MOCK
YUTONG_DEMO_PASSWORD=demo123

# 网关对外端口 (20011)
GATEWAY_PORT=20011

# 后端直连端口 (20010)
BACKEND_PORT=20010

# PostgreSQL 本地映射端口 (20000)
POSTGRES_HOST_PORT=20000
POSTGRES_DB=yutong
POSTGRES_USER=yutong
POSTGRES_PASSWORD=yutong-dev-password

# Redis 本地映射端口 (20001)
REDIS_HOST_PORT=20001
REDIS_PASSWORD=
REDIS_DB=0

# MinIO 本地映射端口 (20002/20003)
MINIO_HOST_PORT=20002
MINIO_CONSOLE_PORT=20003
MINIO_ACCESS_KEY=yutong-minio
MINIO_SECRET_KEY=yutong-minio-dev-secret
MINIO_BUCKET=yutong-files
