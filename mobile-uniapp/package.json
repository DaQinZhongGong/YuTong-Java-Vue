{
  "name": "yutong-mobile-uniapp",
  "version": "0.1.0",
  "private": true,
  "description": "YuTong Mobile App built with Uniapp + Vue3 + TypeScript",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020120260710001",
    "vue": "3.4.21",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020120260710001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020120260710001",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.0.0",
    "@vue/compiler-core": "3.4.21",
    "@vue/compiler-dom": "3.4.21",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/compiler-ssr": "3.4.21",
    "sass": "^1.101.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.2.8"
  }
