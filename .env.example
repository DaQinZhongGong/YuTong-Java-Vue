# YuTong Platform 环境变量模板 [T]
# 复制为 .env 并填入真实值；生产环境必须使用外部密钥管理，禁止将真实密钥提交到仓库。
# 详见 YuTong-Java-Docs/82-环境变量与密钥管理规范详设
#
# 变量命名说明：82 号文档使用 DB_* 前缀，本项目实现使用 POSTGRES_* 更具体的前缀，
# 两者等价（check-env-vars 脚本支持别名）。生产环境推荐使用 DB_* 对齐规范。
#
# GA2-30 容器前缀规则:
#   所有容器/镜像/网络统一使用 yutong- 前缀, 防止与其他项目 (如 workama-*) 冲突。
#   - 镜像: yutong-backend:latest / yutong-gateway:latest / yutong-web-admin:latest
#   - 容器: yutong-postgres / yutong-redis / yutong-minio / yutong-backend-run / yutong-gateway-run / yutong-web-admin-run
#   - 网络: yutong_default
#   容器内访问依赖必须使用 yutong- 前缀容器名 (非 localhost):
#   POSTGRES_HOST=yutong-postgres / REDIS_HOST=yutong-redis / MINIO_ENDPOINT=http://yutong-minio:9000 / 后端代理=http://yutong-backend-run:8080

# ===== Profile =====
APP_ENV=local
SPRING_PROFILES_ACTIVE=local

# ===== Application Security =====
APP_SECRET=${APP_SECRET}

# ===== PostgreSQL (DB_* 为规范名，POSTGRES_* 为实现别名) =====
DB_HOST=localhost
DB_PORT=20000
DB_NAME=yutong
DB_USER=yutong
DB_PASSWORD=${DB_PASSWORD}
POSTGRES_HOST=localhost
POSTGRES_PORT=20000
POSTGRES_DB=yutong
POSTGRES_USER=yutong
POSTGRES_PASSWORD=yutong-dev-password
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=20001
REDIS_PASSWORD=
REDIS_DB=0

# ===== MinIO (对象存储) =====
MINIO_ENDPOINT=http://localhost:20002
MINIO_ACCESS_KEY=yutong-minio
MINIO_SECRET_KEY=yutong-minio-dev-secret
MINIO_BUCKET=yutong-files

# ===== Docker Compose 宿主机映射端口（与 docker-compose.*.yml 的 ports 映射保持一致） =====
POSTGRES_HOST_PORT=20000
REDIS_HOST_PORT=20001
MINIO_HOST_PORT=20002
MINIO_CONSOLE_PORT=20003

# ===== AI =====
AI_PROVIDER=openai-compatible
AI_API_KEY=${AI_API_KEY}

# ===== Auth (local/test 使用 Mock；生产必须替换为真实 AuthAdapter) =====
# IDENTITY_MODE: 唯一生产身份模式 OIDC/SSO/LDAP_AD/CUSTOMER_IAM/LOCAL_IAM_EXTENSION
IDENTITY_MODE=MOCK
YUTONG_AUTH_MODE=MOCK
# AUTH_MOCK_ENABLED: local 可 true；staging/prod 必须 false
AUTH_MOCK_ENABLED=local,test
YUTONG_AUTH_MOCK_ENABLED_PROFILES=local,test
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# 21-安全合规: refresh token TTL=14d (1209600s)，每次使用必须轮换
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
# refresh token 轮换开关 (21 号文档要求默认启用)
AUTH_REFRESH_ROTATION_ENABLED=true
AUTH_COOKIE_MODE=false

# ===== OIDC (IDENTITY_MODE=OIDC 时必填) =====
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=yutong-web
OIDC_CLIENT_SECRET_REF=${OIDC_CLIENT_SECRET_REF}
OIDC_ALLOWED_ALGS=RS256,ES256
OIDC_REDIRECT_URIS=https://app.example.com/auth/callback
OIDC_CLOCK_SKEW_SECONDS=60

# ===== SSO/CAS/SAML (IDENTITY_MODE=SSO 时必填) =====
SSO_METADATA_URL=https://sso.example.com/metadata
SSO_CERT_REF=${SSO_CERT_REF}

# ===== LDAP/AD (IDENTITY_MODE=LDAP_AD 时必填) =====
LDAP_URL=ldaps://ad.example.com:636
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=${LDAP_BIND_DN}
LDAP_BIND_PASSWORD=${LDAP_BIND_PASSWORD}

# ===== Customer IAM (IDENTITY_MODE=CUSTOMER_IAM 时必填) =====
CUSTOMER_IAM_JWKS_URL=https://iam.example.com/.well-known/jwks.json
CUSTOMER_IAM_AUDIENCE=yutong-api

# ===== Break Glass (应急管理员) =====
BREAK_GLASS_ADMIN_REFS=${BREAK_GLASS_ADMIN_REFS}

# ===== Web =====
VITE_API_BASE_URL=http://localhost:20010/api/v1

# ===== 移动端 =====
MOBILE_API_BASE_URL=http://localhost:20010/api/v1
